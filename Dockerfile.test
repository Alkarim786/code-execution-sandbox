# Development / CI image: Go toolchain plus every language runtime the sandbox supports.
FROM golang:bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 gcc g++ libc6-dev nodejs default-jdk-headless strace procps ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
CMD ["go", "test", "-count=1", "-v", "./..."]
